{
  "name": "refine-extension",
  "displayName": "Refine - 智能知识复用",
  "version": "0.1.0",
  "description": "从 AI 对话中自动提炼知识，支持 ChatGPT、Claude 等",
  "author": "Refine Team",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "plasmo": "^0.89.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0"
  },
  "manifest": {
    "host_permissions": [
      "http://localhost:8787/*",
      "https://api.refine.so/*",
      "https://chat.openai.com/*",
      "https://chatgpt.com/*",
      "https://claude.ai/*"
    ],
    "permissions": [
      "storage",
      "activeTab",
      "alarms"
    ]
  }
}
