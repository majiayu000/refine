{
  "name": "refine-extension",
  "displayName": "Refine - 智能知识复用",
  "version": "0.1.2",
  "description": "从 AI 对话中自动提炼知识，支持 ChatGPT、Claude、Gemini、Grok 等",
  "author": "Refine Team",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "plasmo": "^0.90.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/chrome": "^0.0.260",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "manifest": {
    "host_permissions": [
      "http://localhost:21567/*",
      "http://localhost:21568/*",
      "http://localhost:21569/*",
      "http://localhost:21570/*",
      "http://127.0.0.1:21567/*",
      "http://127.0.0.1:21568/*",
      "http://127.0.0.1:21569/*",
      "http://127.0.0.1:21570/*",
      "https://api.refine.so/*",
      "https://chat.openai.com/*",
      "https://chatgpt.com/*",
      "https://claude.ai/*",
      "https://gemini.google.com/*",
      "https://grok.com/*",
      "https://*.grok.com/*",
      "https://x.com/i/grok*",
      "https://twitter.com/i/grok*",
      "https://x.ai/grok*",
      "https://*.x.ai/grok*"
    ],
    "permissions": [
      "storage",
      "activeTab",
      "alarms"
    ]
  }
}
