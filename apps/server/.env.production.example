REFINE_ENV=production
REFINE_API_TOKEN=replace_with_strong_random_token
REFINE_FREE_QUOTA_ITEMS=100

# Optional lexical feature-hash retrieval (not learned semantic embeddings)
REFINE_ENABLE_FEATURE_HASH_SEARCH=false

# Optional extraction provider configuration
REFINE_ANTHROPIC_API_KEY=your_key
REFINE_ANTHROPIC_BASE_URL=https://api.anthropic.com
REFINE_ANTHROPIC_MODEL=claude-opus-4-6
